ENVIRONMENT=development
# Accepts postgresql+asyncpg://, postgresql:// or postgres:// URLs, including Neon's ?sslmode=require form.
DATABASE_URL=postgresql+asyncpg://gci:gci@localhost:55432/gci
# Migrations only. Set to a direct (non-pooler) URL when DATABASE_URL points at PgBouncer.
DATABASE_URL_UNPOOLED=
# 0 disables client-side pooling, the recommended setting behind PgBouncer.
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=3
CORS_ORIGINS=http://localhost:3000
# Unset behind uvicorn's proxy-header handling; x-real-ip on Vercel.
TRUSTED_CLIENT_IP_HEADER=
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_SECONDS=600
# Required, at least 32 characters. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RATE_LIMIT_HASH_KEY=
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
# Notification emails per hour across all clients; enquiries past it are stored without an email.
NOTIFICATIONS_PER_HOUR=200
MAIL_FROM=website@example.com
NOTIFY_TO=enquiries@example.com
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1
# Self-hosted staff console authentication. Leave STAFF_AUTH_SECRET empty to disable it.
# At least 32 characters. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STAFF_AUTH_SECRET=
# Sender for one-time sign-in codes and staff invitations (defaults to noreply@<MAIL_FROM domain>).
AUTH_MAIL_FROM=noreply@example.com
SITE_URL=https://gamechanger.institute

# Public path prefix stripped before routing. Vercel routes /api/* to this service: set /api there.
API_ROOT_PATH=
