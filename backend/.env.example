ENVIRONMENT=development
# Accepts postgresql+asyncpg://, postgresql:// or postgres:// URLs, including Neon's ?sslmode=require form.
DATABASE_URL=postgresql+asyncpg://gci:gci@localhost:55432/gci
# Migrations only. Set to a direct (non-pooler) URL when DATABASE_URL points at PgBouncer.
DATABASE_URL_UNPOOLED=
# 0 disables client-side pooling, the recommended setting behind PgBouncer.
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=3
REDIS_URL=redis://localhost:56379/0
CORS_ORIGINS=http://localhost:3000
# Unset behind uvicorn's proxy-header handling; x-real-ip on Vercel.
TRUSTED_CLIENT_IP_HEADER=
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_SECONDS=600
# Ceiling on accepted submissions per hour across all clients.
RATE_LIMIT_GLOBAL_PER_HOUR=200
# Required, at least 32 characters. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RATE_LIMIT_HASH_KEY=
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=website@example.com
NOTIFY_TO=enquiries@example.com
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1
