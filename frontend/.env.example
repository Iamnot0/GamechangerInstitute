# Public origin of the site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API base URL. Leave unset on Vercel (defaults to the same-origin /api service).
# Locally, point it at the FastAPI dev server.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the server reaches the staff service. On Vercel the service binding sets BACKEND_INTERNAL_URL instead.
ADMIN_API_URL=http://localhost:8000
# The storage host uploads are served from; the same value as the backend's MEDIA_ALLOWED_HOSTS.
MEDIA_HOST=
# Vercel Blob token for uploads from the staff console.
BLOB_READ_WRITE_TOKEN=
# The same value as the backend's VISITOR_ADDRESS_KEY.
VISITOR_ADDRESS_KEY=
